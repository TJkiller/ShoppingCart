{% extends "base.html" %}

{% block content %}
    <div class="form-container">
        <h2>Edit Item in Cart</h2>
        <form method="POST" action="{{ url_for('edit_item', index=index) }}">
            <div class="form-group">
                <label for="product">Product Name:</label>
                <input type="text" id="product" name="product" value="{{ item['product'] }}" required>
            </div>
            <div class="form-group">
                <label for="price">Price (R):</label>
                <input type="number" id="price" name="price" step="0.01" min="0.01" value="{{ "%.2f"|format(item['price']) }}" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Save Changes</button>
                <a href="{{ url_for('index') }}" class="btn cancel">Cancel</a>
            </div>
        </form>
    </div>
{% endblock %}